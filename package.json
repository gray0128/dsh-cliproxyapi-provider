{
  "name": "@gray0128/dsh-cliproxyapi-provider",
  "version": "0.0.5",
  "description": "GUI-configurable CLIProxyAPI Responses provider for DeepSeek Harness",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./catalog": "./src/catalog.js",
    "./metadata": "./src/metadata.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["src", "client.js", "cordis.patch.yml", "README.md", "README_EN.md"],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/catalog.js && node --check src/metadata.js && node --check client.js && node --test",
    "pack:github": "npm pack"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gray0128/dsh-cliproxyapi-provider.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.3 <0.2.2-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.3 <0.2.2-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.3 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.3 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.3 <0.2.2-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.3 <0.2.2-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.2.2-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.3 <0.2.2-0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.3 <0.2.2-0",
    "@deepseek-ai/dsh-util-values": ">=0.2.1-rc.3 <0.2.2-0",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.3 <0.2.2-0" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT"
}
